# Copy this file to `.env` (gitignored) and fill in the value.
#
#   cp .env.example .env
#   $EDITOR .env
#
# Then before invoking the wrapper:
#   set -a && . .env && set +a
#   python eval/brief_reconstructor.py art-project_paper/\[jhb\]eval-corpus/sa24-04
#
# Never commit `.env` itself. The .gitignore rule guards it; verify with
# `git check-ignore -v .env` if in doubt.

